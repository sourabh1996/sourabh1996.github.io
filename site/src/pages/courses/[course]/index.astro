---
import Base from "../../../layouts/Base.astro";
import TypeIcon from "../../../components/TypeIcon.astro";
import { getCollection } from "astro:content";
import { courses, url, iconFor } from "../../../lib/catalog.js";

export function getStaticPaths() {
  return courses.map((c) => ({ params: { course: c.slug }, props: { course: c } }));
}
const { course } = Astro.props;
const written = new Set((await getCollection("lessons")).map((e) => e.id));
const unlocks = courses.filter((x) => (x.prerequisites || []).some((p) => p.course === course.title));
const modHref = (p) => (p.course === course.title ? `#${p.anchor}` : url(`courses/${p.slug}`) + `#${p.anchor}`);
---
<Base title={course.title} description={course.description} crumbs={[{ label: "Catalog", href: url() }, { label: course.title }]}>
  <div class="wrap">
    <section class="course-head">
      <div class="card-top" style="justify-content:flex-start;gap:12px"><div class="card-icon" aria-hidden="true">{iconFor(course)}</div><span class={`badge ${course.level}`}>{course.level}</span></div>
      <h1>{course.title}</h1>
      <p class="desc">{course.description}</p>
      <div class="stats"><span><b>{course.module_count}</b> modules</span><span><b>{course.lesson_count}</b> lessons</span><span><b>~{course.hours}</b> hours</span><span>{course.track}</span></div>
      <div class="req">
        <div><b>Finish first:</b>{course.prerequisites?.length ? course.prerequisites.map((p, i) => <>{i > 0 && ", "}<a href={url(`courses/${p.slug}`)}>{p.course}</a></>) : " Nothing, this is a starting point."}</div>
        <div><b>Unlocks:</b>{unlocks.length ? unlocks.map((x, i) => <>{i > 0 && ", "}<a href={url(`courses/${x.slug}`)}>{x.title}</a></>) : " This is a final course."}</div>
      </div>
    </section>
    <div class="content-head"><h2>Course content</h2><span>{course.module_count} Modules • {course.lesson_count} Lessons</span></div>
    {course.modules.map((m) => (
      <details class="module" id={`m${m.index}`} open={m.index <= 2}>
        <summary>
          <span class="num">{m.index}</span>
          <span class="mtitle">{m.title}</span>
          <span class="mprog" data-prog={m.lessons.map((l) => `${course.slug}/${l.slug}`).join(",")} hidden></span>
          <span class="mcount">{m.lessons.length} lesson{m.lessons.length === 1 ? "" : "s"}</span>
          <span class="chev" aria-hidden="true">⌃</span>
        </summary>
        <div class="module-body">
          {m.prerequisites && (
            <div class="before">📚 Before you start: {m.prerequisites.map((p, i) => <>{i > 0 && " · "}<a href={modHref(p)}>{p.course === course.title ? p.module : `${p.course} › ${p.module}`}</a></>)}</div>
          )}
          {m.lessons.map((l) => (
            <a class="lesson" href={url(`courses/${course.slug}/${l.slug}`)} data-id={`${course.slug}/${l.slug}`}>
              <span class="licon"><TypeIcon type={l.type} /></span>
              <span class="ltitle">{l.title} {l.added && <span class="added" title="Added beyond the bootcamp syllabus">➕</span>}</span>
              {l.type === "Article" && !written.has(`${course.slug}/${l.slug}`) && <span class="soon">Soon</span>}
              <span class="ltype"><TypeIcon type={l.type} />{l.type}</span>
            </a>
          ))}
        </div>
      </details>
    ))}
  </div>
  <script>
    let done: string[] = [];
    try { done = JSON.parse(localStorage.getItem("done") || "[]"); } catch {}
    document.querySelectorAll<HTMLElement>(".lesson").forEach((a) => { if (done.includes(a.dataset.id!)) a.classList.add("done"); });
    document.querySelectorAll<HTMLElement>(".mprog").forEach((s) => {
      const ids = s.dataset.prog!.split(",");
      const n = ids.filter((id) => done.includes(id)).length;
      if (n) { s.textContent = `${n}/${ids.length}`; s.hidden = false; }
    });
    if (location.hash) (document.querySelector(location.hash) as HTMLDetailsElement | null)?.setAttribute("open", "");
  </script>
</Base>
